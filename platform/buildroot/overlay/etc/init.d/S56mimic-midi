#!/bin/sh

pidfile=/run/mimic-midi.pid
case "$1" in
  start)
    # Existing Pearl kernel modules provide class-compliant USB host MIDI.
    # Failure does not prevent the independent DIN UART from being available.
    modprobe snd-usb-audio >/dev/null 2>&1 || echo "USB MIDI driver unavailable; DIN MIDI remains enabled" >&2
    start-stop-daemon -S -o -b -m -p "$pidfile" -x /usr/bin/mimicd -O /var/log/mimic-midi.log -- midi-service
    ;;
  stop)
    start-stop-daemon -K -o -p "$pidfile" -x /usr/bin/mimicd
    attempts=0
    while start-stop-daemon -K -t -q -p "$pidfile" -x /usr/bin/mimicd; do
      attempts=$((attempts + 1))
      [ "$attempts" -lt 20 ] || exit 1
      sleep 0.1
    done
    rm -f "$pidfile"
    ;;
  restart)
    "$0" stop && "$0" start
    ;;
  *) exit 2 ;;
esac
